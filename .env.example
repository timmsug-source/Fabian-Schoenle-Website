# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/fabianschoenle/erstgespraech

# Kontaktformular — Versand über den goneo-Postausgang der eigenen Domain.
# Die Zugangsdaten sind dieselben, die auch ein Mailprogramm für das Postfach
# nutzt. Zu finden im goneo-Kundencenter unter den E-Mail-Einstellungen.
SMTP_HOST=smtp.goneo.de
# 465 = direktes TLS (üblich), 587 = STARTTLS. Beides verschlüsselt.
SMTP_PORT=465
# Das Postfach selbst — dient zugleich als Absenderadresse.
SMTP_USER=coaching@fabianschoenle.de
SMTP_PASS=hier-das-postfach-passwort
# Empfänger der Formularanfragen — muss zur Adresse im Impressum passen.
# Ohne Angabe geht die Nachricht an SMTP_USER.
CONTACT_EMAIL=coaching@fabianschoenle.de

# Headless-CMS (Supabase RPC) — Anon-Key ist öffentlich (NEXT_PUBLIC)
NEXT_PUBLIC_HUB_SUPABASE_URL=https://mozhptupmycfmfojbofh.supabase.co
NEXT_PUBLIC_HUB_SUPABASE_ANON_KEY=eyJhbGci...
